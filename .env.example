# GitHub connector token used by the Release Captain agent in TrueForge.
# Fine-grained personal access token scoped to this repository only.
# Required permissions: Contents (read/write), Pull requests (read-only), Commit statuses (read-only)
GITHUB_TOKEN=your_github_token_here

# Model provider API key (OpenAI, Anthropic, or TrueFoundry AI Gateway key)
MODEL_API_KEY=your_model_api_key_here
